# Copy this file to .env   (PowerShell: Copy-Item .env.example .env)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taxi

# Dataset: TOTAL_MONTHS consecutive months of NYC yellow taxi data starting at START_MONTH
START_MONTH=2026-04
TOTAL_MONTHS=4
# Night window on the PICKUP hour, New York local time: from NIGHT_START:00 up to NIGHT_END:00
# (end exclusive): 18 and 6 mean 18:00 to 05:59. Changing these rebuilds the clean files.
NIGHT_START=18
NIGHT_END=6
# Test sizes in months. Labels in the dashboard show the actual row counts.
SIZES=1,2,4

# Benchmark protocol: BENCH_RUNS measured runs after BENCH_WARMUPS warm-up runs (plus one "first" run)
BENCH_RUNS=5
BENCH_WARMUPS=2
BENCH_SEED=42
# shuffle = seeded random query order (same for both engines), fixed = Q1..Q5
BENCH_ORDER=shuffle

# 1 = also build the complete combined dataset (every trip, every column) in data/full
BUILD_FULL_DATASET=0
# 1 = rebuild the cleaned files even if nothing changed
FORCE_REBUILD=0
