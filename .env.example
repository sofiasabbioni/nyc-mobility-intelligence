# Copy this file to .env and set your own password. NEVER commit .env.
POSTGRES_DB=nyc_taxi
POSTGRES_USER=taxi
POSTGRES_PASSWORD=change_me

# Months to download and load (YYYY-MM, comma separated). Also the observation window for cleaning.
# Use one month (e.g. 2026-05) for a fast first test.
TAXI_MONTHS=2026-04,2026-05,2026-06,2026-07

# Test filter for the night table (final criteria TBD): pickups from 20:00 until 05:59
NIGHT_START_HOUR=20
NIGHT_END_HOUR=6

# Port on YOUR laptop for connecting pgAdmin / psql to the container (inside Compose it is always db:5432)
DB_HOST_PORT=5433
